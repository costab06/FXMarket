# ── Server ────────────────────────────────────────────────────────────────────
PORT=9001

# ── OANDA v20 ─────────────────────────────────────────────────────────────────
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# ── Interactive Brokers ───────────────────────────────────────────────────────
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# ── FIX session ───────────────────────────────────────────────────────────────
FIX_CONFIG_PATH=fix.cfg

# ── Feeds and pairs ───────────────────────────────────────────────────────────
ENABLED_FEEDS=["oanda"]
DEFAULT_PAIRS=["EURUSD","GBPUSD","USDJPY","AUDUSD","USDCAD"]

# ── Aggregator / SOR ──────────────────────────────────────────────────────────
STALE_SECONDS=5.0
SOR_STALE_SECONDS=3.0
SOR_MAX_SLIPPAGE_PIPS=3.0
